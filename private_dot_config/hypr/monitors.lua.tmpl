hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })

{{ $environment := .environment -}}
{{ $selectedMonitors := index .monitors .monitors.selected -}}
{{ $defaultProfile := .monitors.default_profile | default (index $selectedMonitors "default_profile") -}}
{{- range $position, $monitor := $selectedMonitors -}}
{{- if not (kindIs "map" $monitor) -}}
    {{ continue }}
{{- end -}}
{{- if not (hasKey $monitor "name") -}}
    {{ continue }}
{{- end -}}
{{- $environmentMonitor := or (index $monitor $environment) $monitor -}}
{{- $scale := pluck "scale" $environmentMonitor $monitor | first -}}
{{- $transform := pluck "transform" $environmentMonitor $monitor | first -}}
{{- $vrr := pluck "vrr" $environmentMonitor $monitor | first -}}
-- {{ $position }}
hl.monitor({
    output = {{ printf "desc:%s" (pluck "name" $environmentMonitor $monitor | first) | quote }},
{{- if not (has $defaultProfile (pluck "profiles" $environmentMonitor $monitor | first)) }}
    disabled = true,
{{- else }}
    mode = {{ pluck "mode" $environmentMonitor $monitor | first | quote }},
    position = {{ pluck "position" $environmentMonitor $monitor | first | quote }},
{{- if $scale }}
    scale = {{ $scale }},
{{- end }}
{{- if ne $transform nil }}
    transform = {{ $transform }},
{{- end }}
{{- if ne $vrr nil }}
    vrr = {{ $vrr }},
{{- end }}
{{- end }}
})
{{ if index $monitor "background" -}}
hl.exec_cmd({{ printf "swaybg --output %q --image %s --mode fill" (index $monitor "name") (index $monitor "background") | quote }})
{{ end -}}
{{ if index $monitor "has_lid" -}}
{{- $output := printf "desc:%s" (pluck "name" $environmentMonitor $monitor | first) }}
hl.bind("switch:off:Lid Switch", function()
    hl.monitor({
        output = {{ $output | quote }},
{{- if (pluck "disable" $environmentMonitor $monitor | first) }}
        disabled = true,
{{- else }}
        mode = {{ pluck "mode" $environmentMonitor $monitor | first | quote }},
        position = {{ pluck "position" $environmentMonitor $monitor | first | quote }},
{{- if $scale }}
        scale = {{ $scale }},
{{- end }}
{{- if $transform }}
        transform = {{ $transform }},
{{- end }}
{{- end }}
    })
end, { locked = true })
hl.bind("switch:on:Lid Switch", function()
    hl.monitor({ output = {{ $output | quote }}, disabled = true })
end, { locked = true })
{{ end }}
{{ end -}}
