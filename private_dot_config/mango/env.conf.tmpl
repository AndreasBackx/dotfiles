# Toolkit/session environment. These are set by Mango before autostart, then
# exported to systemd in exec.conf so DMS and apps launched by user services see
# the same Wayland-oriented environment.

env=XDG_CURRENT_DESKTOP,mango
env=QT_QPA_PLATFORM,wayland
env=ELECTRON_OZONE_PLATFORM_HINT,auto
env=QT_QPA_PLATFORMTHEME,gtk3
env=QT_QPA_PLATFORMTHEME_QT6,gtk3
env=QT_AUTO_SCREEN_SCALE_FACTOR,1
env=GDK_SCALE,2
env=XCURSOR_SIZE,20

# Core login-shell environment. UWSM sources ~/.zprofile, but these explicit
# values keep plain Mango sessions and Mango-spawned apps usable too.
env=XDG_DATA_HOME,{{ .chezmoi.homeDir }}/{{ .relative_xdg_data_home }}
env=XDG_CONFIG_HOME,{{ .chezmoi.homeDir }}/{{ .relative_xdg_config_home }}
env=XDG_STATE_HOME,{{ .chezmoi.homeDir }}/{{ .relative_xdg_state_home }}
env=XDG_CACHE_HOME,{{ .chezmoi.homeDir }}/{{ .relative_xdg_cache_home }}
env=CARGO_HOME,{{ .chezmoi.homeDir }}/{{ .relative_xdg_data_home }}/cargo
env=GOPATH,{{ .chezmoi.homeDir }}/dev/go
env=PNPM_HOME,{{ .chezmoi.homeDir }}/{{ .relative_xdg_cache_home }}/pnpm
env=PATH,{{ .chezmoi.homeDir }}/.bin/wrappers:{{ .chezmoi.homeDir }}/.local/bin:{{ .chezmoi.homeDir }}/.bin:/usr/local/bin:/usr/local/sbin:{{ .chezmoi.homeDir }}/{{ .relative_xdg_data_home }}/cargo/bin:{{ .chezmoi.homeDir }}/dev/go/bin:{{ .chezmoi.homeDir }}/{{ .relative_xdg_data_home }}/pyenv/shims:{{ .chezmoi.homeDir }}/{{ .relative_xdg_data_home }}/pyenv/bin:/usr/bin:{{ .chezmoi.homeDir }}/.npm-global/bin:/var/lib/flatpak/exports/bin:{{ .chezmoi.homeDir }}/.opam/default/bin:{{ .chezmoi.homeDir }}/{{ .relative_xdg_data_home }}/npm/bin:{{ .chezmoi.homeDir }}/{{ .relative_xdg_cache_home }}/pnpm:{{ .chezmoi.homeDir }}/.kilo/bin:{{ .chezmoi.homeDir }}/.opencode/bin:{{ .chezmoi.homeDir }}/{{ .relative_xdg_cache_home }}/pnpm/bin
env=VISUAL,nvim
env=EDITOR,nvim
{{ if eq .environment "work" -}}
env=BROWSER,/usr/bin/google-chrome
{{ else -}}
env=BROWSER,/usr/bin/firefox
{{ end -}}
env=_JAVA_AWT_WM_NONREPARENTING,1
env=MOZ_USE_XINPUT2,1
env=MOZ_ENABLE_WAYLAND,1
env=OBSIDIAN_USE_WAYLAND,1

# DMS integration.
env=TERMINAL,ghostty
env=DMS_DWL_TAG_COUNT,9
env=DMS_DISABLE_MATUGEN,1

{{ if eq .gpu "nvidia" -}}
# NVIDIA/wlroots compatibility. Keep this local to the Mango session.
env=GBM_BACKEND,nvidia-drm
env=__GLX_VENDOR_LIBRARY_NAME,nvidia
env=LIBVA_DRIVER_NAME,nvidia
{{- end }}
