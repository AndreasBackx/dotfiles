#!/usr/bin/env zsh

set -o errexit -o nounset -o pipefail

{{ if and (eq .chezmoi.os "linux") (not .headless) }}
{{ $launcher := "/usr/share/applications/steam.desktop" }}
{{ $library := "/usr/lib64/extest/libextest.so" }}
{{ if and (stat $launcher) (stat $library) }}
# Packaged launcher checksum: {{ include $launcher | sha256sum }}
source_launcher="/usr/share/applications/steam.desktop"
destination="${XDG_DATA_HOME:-$HOME/.local/share}/applications/steam.desktop"
marker="# Generated by chezmoi Steam Extest hook; do not edit."

if [[ -e "$destination" ]] && [[ "$(head -n 1 "$destination")" != "$marker" ]]; then
  >&2 print -r -- "Refusing to overwrite existing Steam launcher: $destination"
  exit 1
fi

contents="$(
  print -r -- "$marker"
  sed 's|/usr/lib/extest/libextest\.so|/usr/lib64/extest/libextest.so|g' "$source_launcher"
)"

if [[ ! -f "$destination" ]] || ! cmp --silent <(print -r -- "$contents") "$destination"; then
  mkdir -p "${destination:h}"
  print -r -- "$contents" > "$destination"
  print -r -- "Updated Steam launcher to use 64-bit Extest: $destination"
fi
{{ end }}
{{ end }}
