#!/usr/bin/env zsh

{{ if .headless }}
# We're headless.
exit 0
{{ end }}

set -o errexit -o nounset -o pipefail

hyprland_log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/hyprland"
mkdir -p "$hyprland_log_dir"

if command -v systemctl >/dev/null 2>&1; then
    systemctl --user daemon-reload
    if systemctl --user cat oo7-daemon.service >/dev/null 2>&1; then
        # Start next login, without competing with the current keyring daemon.
        systemctl --user enable oo7-daemon.service >/dev/null
    fi
    systemctl --user enable --now logrotate-hyprland.timer >/dev/null
    systemctl --user disable dms.service >/dev/null 2>&1 || true
    systemctl --user add-wants mango-session.target dms.service >/dev/null 2>&1 || true
    systemctl --user add-wants hyprland-session.target dms.service >/dev/null 2>&1 || true
fi
